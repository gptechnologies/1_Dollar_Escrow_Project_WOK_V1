# Test/staging environment - unified Arbitrum + Ethereum app
NODE_ENV=test
ENABLE_SERVER_TXS=false

# Backend/indexer chain configuration
ARBITRUM_RPC_HTTP=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
ARBITRUM_RPC_WSS=wss://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
ARBITRUM_FACTORY_ADDRESS=0x_DEPLOYED_ARBITRUM_FACTORY
ARBITRUM_INDEXER_START_BLOCK=ARBITRUM_FACTORY_DEPLOYMENT_BLOCK

ETHEREUM_RPC_HTTP=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ETHEREUM_RPC_WSS=wss://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
ETHEREUM_FACTORY_ADDRESS=0x_DEPLOYED_ETHEREUM_FACTORY
ETHEREUM_INDEXER_START_BLOCK=ETHEREUM_FACTORY_DEPLOYMENT_BLOCK

# Optional legacy server signer. Leave blank while ENABLE_SERVER_TXS=false.
ORACLE_PRIVATE_KEY=

# Shared treasury used by both factories
TREASURY_ADDRESS=0x_YOUR_TREASURY_ADDRESS

# Database (Neon/Supabase/Railway)
# Example Neon: https://neon.tech/
# Example Supabase: https://supabase.com/
# Run schema: packages/oracle/src/db/schema.sql
POSTGRES_URL=

# Redis (Upstash or Redis Cloud)
# Example Upstash: https://upstash.com/
REDIS_URL=

# Oracle API
PORT=3000
WEBHOOK_SHARED_SECRET=

# Vercel UI variables
NEXT_PUBLIC_APP_URL=https://your-vercel-domain.example
INDEXER_API_URL=https://your-indexer.example
NEXT_PUBLIC_ARBITRUM_FACTORY_ADDRESS=0x_DEPLOYED_ARBITRUM_FACTORY
NEXT_PUBLIC_ETHEREUM_FACTORY_ADDRESS=0x_DEPLOYED_ETHEREUM_FACTORY
NEXT_PUBLIC_ARBITRUM_RPC_HTTP=https://arb-mainnet.g.alchemy.com/v2/YOUR_KEY
NEXT_PUBLIC_ETHEREUM_RPC_HTTP=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY

# Deployment verification
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
