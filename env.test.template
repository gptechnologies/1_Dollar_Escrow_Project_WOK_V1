# Test environment - Arbitrum Sepolia
NODE_ENV=test
CHAIN_ID=421614

# Alchemy RPC endpoints for Arbitrum Sepolia
# Get these from: https://dashboard.alchemy.com/
RPC_HTTP=
RPC_WSS=

# Oracle wallet (funded test EOA on Arbitrum Sepolia)
# Create new wallet: https://vanity-eth.tk/ or use MetaMask
# Fund with Sepolia ETH for gas
ORACLE_PRIVATE_KEY=

# Contract addresses (deploy with: cd packages/contracts && npm run deploy:sepolia)
FACTORY_ADDRESS=0x_DEPLOYED_FACTORY_ADDRESS_SEPOLIA
USDC_ADDRESS=0x_DEPLOYED_MOCK_USDC_ADDRESS_SEPOLIA
USDT_ADDRESS=0x_DEPLOYED_MOCK_USDT_ADDRESS_SEPOLIA
TREASURY_ADDRESS=0x_YOUR_TREASURY_ADDRESS

# Database (Neon/Supabase/Railway)
# Example Neon: https://neon.tech/
# Example Supabase: https://supabase.com/
# Run schema: packages/oracle/src/db/schema.sql
POSTGRES_URL=

# Redis (Upstash or Redis Cloud)
# Example Upstash: https://upstash.com/
REDIS_URL=

# Oracle API
PORT=3000
WEBHOOK_SHARED_SECRET=

# Deployment verification
ETHERSCAN_API_KEY=YOUR_ARBISCAN_API_KEY
