# Production environment - Arbitrum One
NODE_ENV=production
CHAIN_ID=42161

# Alchemy RPC endpoints for Arbitrum One
# Get these from: https://dashboard.alchemy.com/
RPC_HTTP=https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY
RPC_WSS=wss://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_API_KEY

# Oracle wallet (SECURE THIS!)
# Recommended: Use hardware wallet or Safe multi-sig for key management
# This wallet only needs gas (ETH) for tx fees
ORACLE_PRIVATE_KEY=0x_YOUR_PROD_ORACLE_PRIVATE_KEY_HERE

# Contract addresses (deploy with: cd packages/contracts && npm run deploy:prod)
FACTORY_ADDRESS=0x_DEPLOYED_FACTORY_ADDRESS_ARBITRUM_ONE
# Real USDC on Arbitrum One
USDC_ADDRESS=0xaf88d065e77c8cC2239327C5EDb3A432268e5831
# Real USDT on Arbitrum One
USDT_ADDRESS=0xFd086bC7CD5C481DCC9C85ebE478A1C0b69FCbb9
# Treasury receives fees and swept late funds (use Safe multi-sig!)
TREASURY_ADDRESS=0x_YOUR_TREASURY_MULTISIG_ADDRESS

# Database (Production-grade Postgres)
# Run schema: packages/oracle/src/db/schema.sql
POSTGRES_URL=postgresql://user:password@your-prod-db-host.com:5432/escrow_prod?sslmode=require
# UI Base price tags also accept DATABASE_URL if that is your platform standard
DATABASE_URL=postgresql://user:password@your-prod-db-host.com:5432/escrow_prod?sslmode=require

# Redis (Production instance - used by Oracle)
REDIS_URL=rediss://default:password@your-prod-redis-host.upstash.io:6379

# Oracle API
PORT=3000
WEBHOOK_SHARED_SECRET=STRONG_RANDOM_SECRET_MIN_32_CHARS_GENERATE_NEW

# TX Sender Configuration (Oracle)
# Thresholds for stuck transaction handling
TX_SPEEDUP_THRESHOLD_MS=120000      # 2 min - first speed-up attempt
TX_REPLACE_THRESHOLD_MS=300000      # 5 min - aggressive replacement
TX_ALERT_THRESHOLD_MS=600000        # 10 min - alert threshold
TX_BACKLOG_ALERT=10                 # Alert when this many TXs pending
# Optional: Webhook for TX alerts (Slack/Discord)
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# ═══════════════════════════════════════════════════════════════════════════════
# UI Environment Variables (packages/ui)
# ═══════════════════════════════════════════════════════════════════════════════

# Oracle API (UI → Oracle communication)
ORACLE_API_URL=https://your-oracle-api.com
ORACLE_API_KEY=SAME_AS_WEBHOOK_SHARED_SECRET

# Upstash Redis for UI rate limiting (HTTP-based, serverless-friendly)
# Get these from: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_UPSTASH_REST_TOKEN

# Base USDC price tags (UI)
NEXT_PUBLIC_APP_URL=https://yourdomain.com
NEXT_PUBLIC_BASE_TESTNET=false
BASE_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
NEXT_PUBLIC_BASE_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
NEXT_PUBLIC_BASE_SEPOLIA_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Deployment verification
ETHERSCAN_API_KEY=YOUR_ARBISCAN_API_KEY
